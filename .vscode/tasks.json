{
  "version": "2.0.0",
  "tasks": [
  {
    "label": "Client: Flutter run (Android)",
    "type": "shell",
    "command": "flutter run -d emulator-5554",
    "options": { "cwd": "${workspaceFolder}/client/flutter_app" },
    "problemMatcher": []
  },
  {
    "label": "Client: Flutter run (Windows), not supported",
    "type": "shell",
    "command": "flutter run -d windows",
    "options": { "cwd": "${workspaceFolder}/client/flutter_app" },
    "problemMatcher": []
  },
  {
    "label": "Client: Flutter run (Web), not supported",
    "type": "shell",
    "command": "flutter run -d chrome",
    "options": { "cwd": "${workspaceFolder}/client/flutter_app" },
    "problemMatcher": []
  },
  {
    "label": "Client: Flutter pub get",
    "type": "shell",
    "command": "flutter pub get",
    "options": { "cwd": "${workspaceFolder}/client/flutter_app" },
    "problemMatcher": []
  },
  {
    "label": "Client: Flutter gen-l10n",
    "type": "shell",
    "command": "flutter gen-l10n",
    "options": { "cwd": "${workspaceFolder}/client/flutter_app" },
    "problemMatcher": []
  }
  ]
}
