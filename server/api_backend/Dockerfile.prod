# This Dockerfile is for the API backend of the application.
# It's the version used for production deployments.

# 1. Base image: Python 3.12 slim version
FROM python:3.12-slim

# 2. Setting environment variables for Python
# Prevent Python from writing .pyc files (saves space/IO)
ENV PYTHONDONTWRITEBYTECODE=1 
# Force immediate log output without memory buffering (essential for Docker logs)
ENV PYTHONUNBUFFERED=1

# 3. Working directory inside the container
WORKDIR /app

# 4. Initially, copy only the requirements and install dependencies
# This is done to leverage Docker's caching mechanism, so that if the requirements.txt file hasn't changed, 
# Docker can reuse the previous layer and avoid reinstalling dependencies at every build, which speeds up the build process.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 5. After that, copy the entire api_backend source code
COPY . .

# 6. Start Uvicorn in production mode
# - No --reload
# - The number of workers is 4, to fully utilize the 2 vCPUs of the VPS
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
