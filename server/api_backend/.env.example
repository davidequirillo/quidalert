# Environment variables
# For some sensible values (like passwords, peppers, jwt secret key, etc.),
# in production we will use additional security measures (like Docker secrets, HashiCorp Vault, etc.) 
# to avoid storing them in plaintext in the .env file

## Development server conf (if using the old start.py and not docker-compose.yml)
SERVER_LOG_LEVEL='info' # 'error', 'warning', 'info', 'debug', 'trace'
WORKERS=1
RELOAD="yes"

## APP_MODE: "development" or "production"
APP_MODE="development"
HOST="localhost"
PORT=8000
# the server name is used for CORS and other security policies, it should be the same as the one used in the frontend conf
# it's the public domain name or IP address of the server, without protocol and port (e.g., "example.com" or "localhost")
SERVER_NAME="localhost"
SERVER_PORT=8000
PROTOCOL="http"
APP_LOG_LEVEL='info' # 'debug', 'info', 'warning'

## Database conf
DB_USER="dbuser"
DB_PASS="dbpass"
DB_NAME="quidalert_db"
DB_HOST="db"
DB_PORT=5432
DB_ENGINE_LOG_ENABLED="yes"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


## Redis DBMS (redis mode can be "single" or "cluster")
# Important note about cluster mode: the number of cluster nodes 
# must be less or equal than the number of logical shards.
# An equal number is recommended (redis nodes number = logical shards number) 
# (see config.py for the number of logical shards)
REDIS_MODE="cluster"
REDIS_URL="redis://redis:6379/0"
REDIS_CLUSTER_NODES="redis-node-1:7001,redis-node-2:7002,redis-node-3:7003"
REDIS_USER="test"
REDIS_PASS="test"
REDIS_MAX_CONNECTIONS=200
REDIS_MAX_CONNECTIONS_PER_NODE=32 # in cluster mode

## Mail sender conf (SMTP server)
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_USER="test"
SMTP_PASS="test"
SMTP_FROM="no-reply@localhost"

## SECURITY CONF (in development mode, you can use simple passwords and peppers, but in production you should use strong random values)

# Password of the first user (admin)
ADMIN_PASS="Password!123"
# Password of the fake users (used for testing, see scripts/seed_users.py)
FAKE_USERS_PASS="Password1234!"

# Pepper string is useful for email hashing (to log email address securely)
# Create it with the following command
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_PEPPER="myemailpepper12345" 

# OTP pepper is useful for verification code hashing
# Create it with the following command
# python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_PEPPER="myotppepperabcde12345"

# GLOBAL pepper is useful for random token hashing
# Create it with the following command
# python -c "import secrets; print(secrets.token_urlsafe(32))"
GLOBAL_PEPPER="myglobalpepper12345"

# Create a jwt secret key with the following command
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="myjwtsecretkey1234567890"

## S3 Storage server
S3_USER="admin"
S3_PASS="password123"
S3_ENDPOINT="http://minio:9000"
S3_BUCKET_NAME="quidalert-uploads"
# You can create them with the S3 web interface
S3_ACCESS_KEY="s3accesskey12345"
S3_SECRET_KEY="s3secretkey67890"

## Firebase keys and options (for push notification to the clients)
FIREBASE_KEYS_PATH="firebase_keys.json"
FIREBASE_PROJECT_ID="my-firebase-project-id"
