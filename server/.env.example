# Environment variables
# The .env file will be used by Docker Compose to set the environment variables for the containers (like fastapi, redis, postgres, minio, etc.). 
# The .env file in production version (see docker-compose.prod.yml) will not be included in the filesystem of the containers (it remains only outside, on the host machine), 
# so the sensitive values (like passwords, peppers, jwt secret key, etc.) will not be exposed inside the containers at filesystem level.
# This is a good practice for a basic security in production.
# To make the system more secure, for some sensible values (like passwords, peppers, jwt secret key, etc.),
# we could use additional security measures (for example, encrypt sensitive values and use Docker Secrets to manage them securely).
# Note: the .env file is not included in the Git repository, 
# so you need to create it manually, copying the .env.example file, and filling in the values for your environment.

## APP_MODE: 'development' or 'production'
APP_MODE='development'
# SERVER_NAME and DOMAIN_NAME variables are used for reverse proxy configuration, email messages, CORS and other policies. 
# Server name should be the same as the one used in the client app (frontend) conf. 
# In production, it should be the public dns name or IP address of the server, 
# without protocol and port (e.g., SERVER_NAME='quidalert.example.com', DOMAIN_NAME='example.com').
# In development, keep SERVER_NAME='localhost' and DOMAIN_NAME='localdomain'.
# Remember to set the correct protocol to be used from client side to communicate to the server side 
# ('http' in development, 'https' in production).
SERVER_NAME='localhost'
DOMAIN_NAME='localdomain'
SERVER_PORT=8000
PROTOCOL='http'
APP_LOG_LEVEL='info' # 'debug', 'info', 'warning'

## Database conf
DB_USER='dbuser'
DB_PASS='dbpass'
DB_NAME='quidalert_db'
DB_HOST='db'
DB_PORT=5432
DB_ENGINE_LOG_ENABLED='yes'
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

## Redis DBMS (redis mode can be 'single' or 'cluster')
# Redis 'single' mode uses REDIS_URL to connect to the single Redis node.
# Redis 'cluster' mode uses REDIS_CLUSTER_NODES to connect to the cluster nodes.
# IMPORTANT NOTE about cluster mode: the number of cluster nodes 
# must be less or equal than the number of logical shards.
# An equal number is recommended (redis nodes number = logical shards number) for better performance.
# NOTE: for each Redis node in the cluster, the port is the same (7001), 
# because it's the port used by each node (in the internal docker network, where fastapi runs), not the external (host) port
REDIS_MODE='cluster'
REDIS_URL='redis://redis:6379/0'
REDIS_CLUSTER_NODES='redis-node-1:7001,redis-node-2:7001,redis-node-3:7001'
# The number of logical shards must be one of the following values: 16, 32, 64, 96, 128.
# If you are unsure, keep REDIS_LOGICAL_SHARDS_NUM = 16 because it's the recommended value for most cases.
# CAUTION: don't change the REDIS_LOGICAL_SHARDS_NUM if the Redis database is not empty, 
# because this variable affects the distribution of data across the shards at runtime, 
# so changing it in non-empty Redis database can cause data loss or corruption.
# Note: REDIS_LOGICAL_SHARDS_NUM is used in both Redis single and cluster modes,
# so if you are using Redis single mode, keep REDIS_LOGICAL_SHARDS_NUM = 16 for obvious performance reasons.
REDIS_LOGICAL_SHARDS_NUM=16
REDIS_USER='redis'
REDIS_PASS='testpassword123'
REDIS_MAX_CONNECTIONS=200
REDIS_MAX_CONNECTIONS_PER_NODE=32 # in cluster mode

## Mail sender conf (SMTP server)
# Note: in development mode, we use a local SMTP server (mailpit) 
# that sends all emails to a local web interface.
# Mailpit does not support authentication or TLS,
# so we must leave SMTP_USER and SMTP_PASS empty and set SMTP_USE_TLS to 'no'
# In production mode, you should set SMTP_USER, SMTP_PASS, and SMTP_USE_TLS according to your SMTP server configuration.
SMTP_HOST='mailpit'
SMTP_PORT=1025
SMTP_USER=''
SMTP_PASS=''
SMTP_FROM='no-reply@example.com'
SMTP_FROM_NAME='Quidalert'
SMTP_USE_TLS='no'
# The following two options allow to redirect all email messages for fake users (xxxxxxxx@example.com)
# to a single email address. It's useful only for testing purposes.
# If you are not sure, set this to 'no'.
# If you set this to 'yes', be careful: it can be a security risk in production
SMTP_ALLOW_REDIRECT_FAKE_USERS_EMAIL='no'
SMTP_REDIRECT_FAKE_USERS_EMAIL_TO=''

## SECURITY CONF (in development mode, you can use simple passwords and peppers, but in production you should use strong random values)

# Password of the first user (admin). Keep it secret and change it in production.
ADMIN_PASS='Password!123'
# Password of the fake users (used for testing, see scripts/seed_users.py).
# Keep it secret and change it in production. Note: fake users email ends with '@example.com'
FAKE_USERS_PASS='Password1234!'

# Pepper string is useful for email hashing (to log email address securely)
# Create it with the following command
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
EMAIL_PEPPER='myemailpepper12345' 

# OTP pepper is useful for verification code hashing
# Create it with the following command
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
OTP_PEPPER='myotppepperabcde12345'

# GLOBAL pepper is useful for random token hashing
# Create it with the following command
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
GLOBAL_PEPPER='myglobalpepper12345'

# Create a jwt secret key with the following command
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY='myjwtsecretkey1234567890'

## S3 Storage server
S3_USER='admin'
S3_PASS='password123'
S3_ENDPOINT='http://minio:9000'
S3_BUCKET_NAME='quidalert-uploads'
S3_ACCESS_KEY='s3-custom-access-key'
S3_SECRET_KEY='a-very-complex-secret-key-123'

## Firebase keys and options (for push notification to the clients)
FIREBASE_KEYS_PATH='firebase_keys.json'
FIREBASE_PROJECT_ID='my-firebase-project-id'
